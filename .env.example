# ==============================================================================
# JiraniPass Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL on port 5433)
DATABASE_URL="postgresql://jiranipass:jiranipass_secret_password@localhost:5433/jiranipass_db?schema=public"

# Redis Connection (BullMQ Outbox Queue & PubSub)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API Server Configuration
PORT=4000
NODE_ENV="development"
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# JWT Authentication
JWT_SECRET="jiranipass_dev_super_secret_jwt_key_at_least_32_characters"
JWT_EXPIRES_IN="30m"

# WhatsApp Business Cloud API Configuration (Meta)
META_GRAPH_API_VERSION="v20.0"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret_for_webhook_signature_verification"
META_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
META_SYSTEM_USER_TOKEN="your_permanent_system_user_access_token"
META_WEBHOOK_VERIFY_TOKEN="your_configured_webhook_verify_token"
WHATSAPP_TEMPLATE_NAME="estate_visitor_access_request"

# Visit Request Timing Defaults (in minutes)
DEFAULT_APPROVAL_TTL_MINUTES=10
DEFAULT_DATA_RETENTION_DAYS=90
